    {"name": "referral", "label": "How did you hear about me?", "type": "select", "options": ["Personal Website", "Google", "Facebook", "Instagram", "The Knot", "Yelp", "Thumbtack", "Vendor Referral", "Client Referral", "Other", "Unknown"]},
    {"name": "vision", "label": "Tell me about your vision for your wedding or our photoshoot!", "type": "textarea", "placeholder": "What do I need to know about the project?"}
