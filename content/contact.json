    {"name": "partner-name", "label": "Partner's Name", "type": "text"},
    {"name": "email", "label": "Your Email", "type": "email", "placeholder": "E.g. myemail@email.com", "autocomplete": "email", "required": true},
    {"name": "phone", "label": "Phone Number", "type": "tel", "placeholder": "E.g. 541 444 0755", "autocomplete": "tel", "required": true},
    {"name": "event", "label": "Event to Capture", "type": "select", "required": true, "options": ["Branding Session", "Elopement", "Engagements", "Event", "Proposal", "Wedding", "Other"]},
    {"name": "investment", "label": "Planned photography investment", "hint": "*Minimum wedding investment $3950*", "type": "text"},
